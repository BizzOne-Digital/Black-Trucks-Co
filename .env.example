# ─── Database (MongoDB Compass: blacktrucksco) ───────────────────────────────
# Local Compass:
MONGODB_URI="mongodb://127.0.0.1:27017/blacktrucksco"
# Atlas example:
# MONGODB_URI="mongodb+srv://USER:PASS@cluster.mongodb.net/blacktrucksco?retryWrites=true&w=majority"

# ─── Auth ────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-long-random-string"

# ─── Gmail SMTP (REQUIRED for booking emails) ────────────────────────────────
# 1. Open https://myaccount.google.com/security
# 2. Turn on 2-Step Verification
# 3. Create an App Password: https://myaccount.google.com/apppasswords
# 4. Paste the 16-character App Password into SMTP_PASS below (no spaces)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="blacktrucksco@gmail.com"
SMTP_PASS="REPLACE_WITH_GMAIL_APP_PASSWORD"
EMAIL_FROM="blacktrucksco@gmail.com"
ADMIN_EMAIL="blacktrucksco@gmail.com"
SUPPORT_EMAIL="blacktrucksco@gmail.com"
SUPPORT_PHONE="647-706-6325"

# ─── Stripe ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Google Maps (optional) ──────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ─── Cron ────────────────────────────────────────────────────────────────────
CRON_SECRET="btc_cron_secret_change_in_production"
