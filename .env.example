# ─── Database (MongoDB Compass: blacktrucksco) ───────────────────────────────
MONGODB_URI="mongodb://127.0.0.1:27017/blacktrucksco"

# ─── Auth ────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-long-random-string"

# ─── Site URL (Stripe redirect after payment — no trailing slash) ────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Gmail SMTP (booking + contact emails) ───────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="blacktrucksco@gmail.com"
SMTP_PASS="REPLACE_WITH_GMAIL_APP_PASSWORD"
EMAIL_FROM="blacktrucksco@gmail.com"
ADMIN_EMAIL="blacktrucksco@gmail.com"
SUPPORT_EMAIL="blacktrucksco@gmail.com"
SUPPORT_PHONE="647-706-6325"

# ─── Stripe (online payments only — test keys until live) ────────────────────
# Dashboard: https://dashboard.stripe.com/test/apikeys
# Webhook (local): stripe listen --forward-to localhost:3000/api/stripe/webhook
# Webhook (prod):  https://your-domain.com/api/stripe/webhook
# Event: checkout.session.completed
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Google Maps (optional) ──────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ─── Cron ────────────────────────────────────────────────────────────────────
CRON_SECRET="btc_cron_secret_change_in_production"
